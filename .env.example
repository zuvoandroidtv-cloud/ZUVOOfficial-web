# ==============================================================================
# ZUVO TV ENTERPRISE CRM & OFFICIAL WEB — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Client-side configuration safe for browser exposure.
# IMPORTANT: DO NOT PLACE SERVICE_ROLE KEYS, DATABASE PASSWORDS, VAULT SECRETS,
# OR PRIVATE CREDENTIALS IN THIS FILE OR ANY BROWSER-ACCESSIBLE FILE.
#

# --- SUPABASE PRODUCTION CONFIGURATION ---
# Primary Supabase Project URL and Public Anonymous Key (safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# --- APPLICATION HOST & ROUTING ---
# Official ZUVO CRM production URL (used for webhooks, warranty registration links, etc.)
VITE_ZUVO_CRM_URL=https://crm.zuvoandroidtv.com

# --- OPTIONAL INTEGRATION ENVIRONMENT FLAGS ---
# Controls client-side environment mode (e.g. production, staging, development)
VITE_APP_ENV=production

